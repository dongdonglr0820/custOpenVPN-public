diff --git a/src/openvpn/system_disk_core.c b/src/openvpn/system_disk_core.c
new file mode 100644
index 00000000..58f15a5f
--- /dev/null
+++ b/src/openvpn/system_disk_core.c
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include "syshead.h"
+#if defined(TARGET_LINUX) || defined(TARGET_DARWIN)
+#include "system_disk.h"
+#include "system_disk_core.h"
+#include "error.h"
+#if defined(TARGET_DARWIN)
+#define XY_DISK_SCHEMA "mac-system-disk-v1"
+#else
+#define XY_DISK_SCHEMA "linux-system-disk-v1"
+#endif
+
+const char *
+unix_system_disk_peer_info(const struct env_set *es, struct gc_arena *gc)
+{
+    if (env_set_get(es, "IV_DISK") || env_set_get(es, "UV_SYSTEM_DISK_SCHEMA"))
+    {
+        msg(M_FATAL, "SYSTEM_DISK_CONFIG_CONFLICT: remove setenv IV_DISK/UV_SYSTEM_DISK_SCHEMA; the system disk is collected automatically");
+    }
+    struct xy_system_disk disk;
+    char error[128];
+    if (!xy_collect_system_disk(&disk, error))
+    {
+        msg(M_FATAL, "SYSTEM_DISK_ERROR: stage=%s; diagnose with --show-system-disk", error);
+    }
+    struct buffer out = alloc_buf_gc(512, gc);
+    if (!buf_printf(&out, "IV_DISK=%s\nUV_SYSTEM_DISK_SCHEMA=%s\n", disk.serial, XY_DISK_SCHEMA))
+    {
+        msg(M_FATAL, "SYSTEM_DISK_ERROR: peer-info capacity");
+    }
+    msg(M_INFO, "System disk identity collected: schema=%s source=system-volume", XY_DISK_SCHEMA);
+    return BSTR(&out);
+}
+
+bool
+unix_show_system_disk(void)
+{
+    struct xy_system_disk disk;
+    char error[128];
+    if (!xy_collect_system_disk(&disk, error))
+    {
+        msg(M_INFO | M_NOPREFIX, "SYSTEM_DISK_ERROR: stage=%s", error);
+        return false;
+    }
+    msg(M_INFO | M_NOPREFIX, "schema=%s", XY_DISK_SCHEMA);
+    msg(M_INFO | M_NOPREFIX, "system_disk=%s", disk.device);
+    msg(M_INFO | M_NOPREFIX, "IV_DISK=%s", disk.serial);
+    return true;
+}
+#endif
