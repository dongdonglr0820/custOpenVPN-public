diff --git a/src/openvpn/system_disk.c b/src/openvpn/system_disk.c
new file mode 100644
index 00000000..b494682c
--- /dev/null
+++ b/src/openvpn/system_disk.c
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "system_disk.h"
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+
+bool
+xy_disk_fail(char error[128], const char *stage)
+{
+    snprintf(error, 128, "%s", stage);
+    return false;
+}
+
+bool
+xy_disk_serial(const char *value, char out[XY_DISK_SERIAL_CAP])
+{
+    size_t len = strlen(value);
+    /* sysfs and IORegistry sometimes pad serials. Never strip internal bytes. */
+    while (len && value[0] == ' ') { ++value; --len; }
+    while (len && value[len - 1] == ' ') { --len; }
+    if (!len || len >= XY_DISK_SERIAL_CAP) { return false; }
+    bool meaningful = false;
+    for (size_t i = 0; i < len; ++i)
+    {
+        unsigned char c = (unsigned char)value[i];
+        if (c < 32 || c > 126) { return false; }
+        if (isalnum(c) && c != '0' && c != 'f' && c != 'F') { meaningful = true; }
+    }
+    if (!meaningful) { return false; }
+    memcpy(out, value, len);
+    out[len] = '\0';
+    const char *invalid[] = { "unknown", "none", "null", "default string",
+                              "to be filled by o.e.m.", "not specified" };
+    char lower[XY_DISK_SERIAL_CAP];
+    for (size_t i = 0; i <= len; ++i) { lower[i] = (char)tolower((unsigned char)out[i]); }
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+    {
+        if (!strcmp(lower, invalid[i])) { return false; }
+    }
+    return true;
+}
