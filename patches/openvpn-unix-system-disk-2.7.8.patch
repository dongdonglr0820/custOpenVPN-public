diff --git a/src/openvpn/system_disk_linux.c b/src/openvpn/system_disk_linux.c
new file mode 100644
index 00000000..6ef3bbf6
--- /dev/null
+++ b/src/openvpn/system_disk_linux.c
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifdef __linux__
+#define _GNU_SOURCE
+#include "system_disk.h"
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+struct disk_walk
+{
+    char leaf[PATH_MAX];
+    char ancestors[32][PATH_MAX];
+    char *error;
+};
+
+static bool
+join_path(char out[PATH_MAX], const char *base, const char *suffix)
+{
+    int n = snprintf(out, PATH_MAX, "%s/%s", base, suffix);
+    return n > 0 && n < PATH_MAX;
+}
+
+static bool
+walk_disk(const char *path, unsigned int depth, struct disk_walk *walk)
+{
+    char node[PATH_MAX], marker[PATH_MAX];
+    if (depth >= 32) { return xy_disk_fail(walk->error, "linux-storage-depth"); }
+    if (!realpath(path, node)) { return xy_disk_fail(walk->error, "linux-resolve-device"); }
+    if (!join_path(marker, node, "partition")) { return xy_disk_fail(walk->error, "linux-path-length"); }
+    struct stat st;
+    if (stat(marker, &st) == 0)
+    {
+        /* A partition belongs to its actual sysfs parent, regardless of sdX/NVMe numbering. */
+        char *slash = strrchr(node, '/');
+        if (!slash || slash == node) { return xy_disk_fail(walk->error, "linux-partition-parent"); }
+        *slash = '\0';
+    }
+    else if (errno != ENOENT) { return xy_disk_fail(walk->error, "linux-partition-query"); }
+    for (unsigned int i = 0; i < depth; ++i)
+    {
+        if (!strcmp(walk->ancestors[i], node)) { return xy_disk_fail(walk->error, "linux-storage-cycle"); }
+    }
+    strcpy(walk->ancestors[depth], node);
+    if (!join_path(marker, node, "slaves")) { return xy_disk_fail(walk->error, "linux-path-length"); }
+    DIR *dir = opendir(marker);
+    if (!dir) { return xy_disk_fail(walk->error, "linux-slaves-query"); }
+    bool has_slave = false, ok = true;
+    struct dirent *entry;
+    errno = 0;
+    while ((entry = readdir(dir)))
+    {
+        if (entry->d_name[0] == '.') { continue; }
+        char child[PATH_MAX];
+        has_slave = true;
+        if (!join_path(child, marker, entry->d_name) || !walk_disk(child, depth + 1, walk))
+        {
+            ok = false;
+            break;
+        }
+        errno = 0;
+    }
+    if (ok && errno) { ok = xy_disk_fail(walk->error, "linux-slaves-read"); }
+    closedir(dir);
+    if (!ok || has_slave) { return ok; }
+    if (walk->leaf[0] && strcmp(walk->leaf, node))
+    {
+        return xy_disk_fail(walk->error, "linux-multiple-system-disks");
+    }
+    strcpy(walk->leaf, node);
+    return true;
+}
+
+bool
+xy_linux_disk_from_sysfs(const char *sysroot, unsigned int major_number,
+                         unsigned int minor_number, struct xy_system_disk *disk,
+                         char error[128])
+{
+    memset(disk, 0, sizeof(*disk));
+    error[0] = '\0';
+    char path[PATH_MAX];
+    int n = snprintf(path, sizeof(path), "%s/dev/block/%u:%u", sysroot, major_number, minor_number);
+    if (n < 0 || n >= (int)sizeof(path)) { return xy_disk_fail(error, "linux-path-length"); }
+    struct disk_walk *walk = calloc(1, sizeof(*walk));
+    if (!walk) { return xy_disk_fail(error, "linux-allocation"); }
+    walk->error = error;
+    bool ok = walk_disk(path, 0, walk);
+    char leaf[PATH_MAX];
+    strcpy(leaf, walk->leaf);
+    free(walk);
+    if (!ok || !leaf[0]) { return false; }
+
+    /* SCSI/SATA and NVMe export the same serial semantics at different paths.
+     * An existing but invalid serial is a failure, never permission to switch IDs. */
+    const char *attributes[] = { "device/serial", "serial" };
+    FILE *file = NULL;
+    for (size_t i = 0; i < sizeof(attributes) / sizeof(attributes[0]); ++i)
+    {
+        if (!join_path(path, leaf, attributes[i])) { return xy_disk_fail(error, "linux-path-length"); }
+        file = fopen(path, "r");
+        if (file) { break; }
+        if (errno != ENOENT) { return xy_disk_fail(error, "linux-serial-read"); }
+    }
+    if (!file) { return xy_disk_fail(error, "linux-system-disk-serial-unavailable"); }
+    char serial[1024];
+    size_t length = fread(serial, 1, sizeof(serial) - 1, file);
+    bool read_ok = !ferror(file) && feof(file) && !memchr(serial, '\0', length);
+    fclose(file);
+    /* sysfs appends precisely one record terminator; embedded newlines remain invalid. */
+    if (length && serial[length - 1] == '\n') { --length; }
+    serial[length] = '\0';
+    if (!read_ok || !xy_disk_serial(serial, disk->serial))
+    {
+        return xy_disk_fail(error, "linux-system-disk-serial-invalid");
+    }
+    const char *name = strrchr(leaf, '/');
+    n = snprintf(disk->device, sizeof(disk->device), "/dev/%s", name ? name + 1 : leaf);
+    if (n < 0 || n >= (int)sizeof(disk->device)) { return xy_disk_fail(error, "linux-device-name"); }
+    return true;
+}
+
+bool
+xy_collect_system_disk(struct xy_system_disk *disk, char error[128])
+{
+    struct stat before, after;
+    if (stat("/", &before)) { return xy_disk_fail(error, "linux-root-stat"); }
+    if (!major(before.st_dev)) { return xy_disk_fail(error, "linux-root-not-a-single-block-device"); }
+    if (!xy_linux_disk_from_sysfs("/sys", major(before.st_dev), minor(before.st_dev), disk, error))
+    {
+        return false;
+    }
+    if (stat("/", &after) || before.st_dev != after.st_dev)
+    {
+        return xy_disk_fail(error, "linux-root-device-changed");
+    }
+    return true;
+}
+#endif
diff --git a/src/openvpn/system_disk_macos.c b/src/openvpn/system_disk_macos.c
new file mode 100644
index 00000000..5bd1f1b1
--- /dev/null
+++ b/src/openvpn/system_disk_macos.c
@@ -0,0 +1,254 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifdef __APPLE__
+#include "system_disk.h"
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOBSD.h>
+#include <IOKit/IOKitLib.h>
+#include <IOKit/storage/IOMedia.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+static bool
+bsd_disk_name(const char *name)
+{
+    if (strncmp(name, "disk", 4)) { return false; }
+    const char *p = name + 4;
+    if (*p < '0' || *p > '9') { return false; }
+    while (*p >= '0' && *p <= '9') { ++p; }
+    while (*p == 's')
+    {
+        ++p;
+        if (*p < '0' || *p > '9') { return false; }
+        while (*p >= '0' && *p <= '9') { ++p; }
+    }
+    return !*p;
+}
+
+static bool
+dict_string(CFDictionaryRef dict, CFStringRef key, char *out, size_t size)
+{
+    CFTypeRef value = CFDictionaryGetValue(dict, key);
+    return value && CFGetTypeID(value) == CFStringGetTypeID()
+           && CFStringGetCString(value, out, (CFIndex)size, kCFStringEncodingUTF8);
+}
+
+/* Pure selection logic, also used by the APFS/snapshot/Fusion fixture tests. */
+bool
+xy_macos_store_from_info(CFDictionaryRef root, char store[128], char error[128])
+{
+    CFTypeRef stores = CFDictionaryGetValue(root, CFSTR("APFSPhysicalStores"));
+    if (stores)
+    {
+        if (CFGetTypeID(stores) != CFArrayGetTypeID() || CFArrayGetCount(stores) != 1)
+        {
+            return xy_disk_fail(error, "mac-apfs-requires-one-physical-store");
+        }
+        CFTypeRef item = CFArrayGetValueAtIndex(stores, 0);
+        if (CFGetTypeID(item) != CFDictionaryGetTypeID()
+            || !dict_string(item, CFSTR("APFSPhysicalStore"), store, 128))
+        {
+            return xy_disk_fail(error, "mac-apfs-physical-store-invalid");
+        }
+    }
+    else
+    {
+        if (CFDictionaryContainsKey(root, CFSTR("APFSContainerReference")))
+        {
+            return xy_disk_fail(error, "mac-apfs-physical-store-missing");
+        }
+        if (!dict_string(root, CFSTR("DeviceIdentifier"), store, 128))
+        {
+            return xy_disk_fail(error, "mac-root-device-missing");
+        }
+    }
+    if (!bsd_disk_name(store)) { return xy_disk_fail(error, "mac-invalid-bsd-device"); }
+    return true;
+}
+
+static long long
+monotonic_ms(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) { return -1; }
+    return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+/* Fixed executable/arguments; no shell, PATH lookup or configurable command.
+ * Bound both output and elapsed time, and always reap the child. */
+static CFDictionaryRef
+disk_info(const char *device, char error[128])
+{
+    int pipefd[2];
+    if (pipe(pipefd)) { xy_disk_fail(error, "mac-diskutil-pipe"); return NULL; }
+    long long start = monotonic_ms();
+    if (start < 0) { close(pipefd[0]); close(pipefd[1]); xy_disk_fail(error, "mac-clock"); return NULL; }
+    pid_t child = fork();
+    if (!child)
+    {
+        close(pipefd[0]);
+        if (dup2(pipefd[1], STDOUT_FILENO) < 0) { _exit(126); }
+        close(pipefd[1]);
+        int nullfd = open("/dev/null", O_WRONLY);
+        if (nullfd < 0 || dup2(nullfd, STDERR_FILENO) < 0) { _exit(126); }
+        close(nullfd);
+        execl("/usr/sbin/diskutil", "diskutil", "info", "-plist", device, (char *)NULL);
+        _exit(127);
+    }
+    close(pipefd[1]);
+    if (child < 0) { close(pipefd[0]); xy_disk_fail(error, "mac-diskutil-fork"); return NULL; }
+    const size_t cap = 1024 * 1024;
+    unsigned char *data = malloc(cap);
+    size_t used = 0;
+    bool ok = data != NULL, eof = false;
+    int status = 0;
+    while (ok && !eof)
+    {
+        long long now = monotonic_ms();
+        long long left = now < 0 ? 0 : 15000 - (now - start);
+        if (left <= 0 || used == cap) { ok = false; break; }
+        struct pollfd fd = { pipefd[0], POLLIN, 0 };
+        int ready = poll(&fd, 1, (int)left);
+        if (ready < 0 && errno == EINTR) { continue; }
+        if (ready <= 0) { ok = false; break; }
+        ssize_t n = read(pipefd[0], data + used, cap - used);
+        if (n < 0 && errno == EINTR) { continue; }
+        if (n < 0) { ok = false; break; }
+        if (!n) { eof = true; }
+        else { used += (size_t)n; }
+    }
+    close(pipefd[0]);
+    if (!ok) { kill(child, SIGKILL); }
+    /* EOF is normally followed immediately by exit; the deadline still applies. */
+    for (;;)
+    {
+        pid_t result = waitpid(child, &status, WNOHANG);
+        if (result == child) { break; }
+        if (result < 0 && errno == EINTR) { continue; }
+        if (result < 0) { ok = false; break; }
+        long long now = monotonic_ms();
+        if (!ok || now < 0 || now - start >= 15000)
+        {
+            ok = false;
+            kill(child, SIGKILL);
+            while (waitpid(child, &status, 0) < 0 && errno == EINTR) { }
+            break;
+        }
+        struct timespec delay = { 0, 10000000 };
+        nanosleep(&delay, NULL);
+    }
+    CFPropertyListRef plist = NULL;
+    if (ok && WIFEXITED(status) && !WEXITSTATUS(status) && used)
+    {
+        CFDataRef bytes = CFDataCreate(kCFAllocatorDefault, data, (CFIndex)used);
+        if (bytes)
+        {
+            plist = CFPropertyListCreateWithData(kCFAllocatorDefault, bytes,
+                                                kCFPropertyListImmutable, NULL, NULL);
+            CFRelease(bytes);
+        }
+    }
+    free(data);
+    if (!plist || CFGetTypeID(plist) != CFDictionaryGetTypeID())
+    {
+        if (plist) { CFRelease(plist); }
+        xy_disk_fail(error, "mac-diskutil-query-failed-or-timeout");
+        return NULL;
+    }
+    return (CFDictionaryRef)plist;
+}
+
+static bool
+media_serial(const char *whole, char serial[XY_DISK_SERIAL_CAP], char error[128])
+{
+    CFMutableDictionaryRef match = IOBSDNameMatching(kIOMainPortDefault, 0, whole);
+    if (!match) { return xy_disk_fail(error, "mac-iokit-match"); }
+    io_registry_entry_t node = IOServiceGetMatchingService(kIOMainPortDefault, match);
+    if (!node) { return xy_disk_fail(error, "mac-iokit-device-missing"); }
+    CFTypeRef is_whole = IORegistryEntryCreateCFProperty(node, CFSTR(kIOMediaWholeKey),
+                                                        kCFAllocatorDefault, 0);
+    bool valid_media = IOObjectConformsTo(node, kIOMediaClass) && is_whole
+                       && CFEqual(is_whole, kCFBooleanTrue);
+    if (is_whole) { CFRelease(is_whole); }
+    if (!valid_media) { IOObjectRelease(node); return xy_disk_fail(error, "mac-iokit-not-whole-media"); }
+    bool ok = false;
+    for (unsigned int depth = 0; node && depth < 32; ++depth)
+    {
+        CFTypeRef value = IORegistryEntryCreateCFProperty(node, CFSTR("Serial Number"),
+                                                         kCFAllocatorDefault, 0);
+        if (!value)
+        {
+            CFTypeRef characteristics = IORegistryEntryCreateCFProperty(node, CFSTR("Device Characteristics"),
+                                                                        kCFAllocatorDefault, 0);
+            if (characteristics)
+            {
+                if (CFGetTypeID(characteristics) == CFDictionaryGetTypeID())
+                {
+                    value = CFDictionaryGetValue(characteristics, CFSTR("Serial Number"));
+                    if (value) { CFRetain(value); }
+                }
+                CFRelease(characteristics);
+            }
+        }
+        if (value)
+        {
+            char raw[1024];
+            ok = CFGetTypeID(value) == CFStringGetTypeID()
+                 && CFStringGetCString(value, raw, sizeof(raw), kCFStringEncodingUTF8)
+                 && xy_disk_serial(raw, serial);
+            CFRelease(value);
+            break; /* Invalid serials never cause a switch to another ancestor's ID. */
+        }
+        io_registry_entry_t parent = IO_OBJECT_NULL;
+        IORegistryEntryGetParentEntry(node, kIOServicePlane, &parent);
+        IOObjectRelease(node);
+        node = parent;
+    }
+    if (node) { IOObjectRelease(node); }
+    if (!ok) { return xy_disk_fail(error, "mac-system-disk-serial-unavailable-or-invalid"); }
+    return true;
+}
+
+bool
+xy_collect_system_disk(struct xy_system_disk *disk, char error[128])
+{
+    memset(disk, 0, sizeof(*disk));
+    error[0] = '\0';
+    CFDictionaryRef root = disk_info("/", error);
+    if (!root) { return false; }
+    char store[128], whole[128];
+    bool ok = xy_macos_store_from_info(root, store, error);
+    CFRelease(root);
+    if (!ok) { return false; }
+    CFDictionaryRef info = disk_info(store, error);
+    if (!info) { return false; }
+    CFTypeRef is_whole = CFDictionaryGetValue(info, CFSTR("WholeDisk"));
+    if (is_whole && CFEqual(is_whole, kCFBooleanTrue))
+    {
+        ok = dict_string(info, CFSTR("DeviceIdentifier"), whole, sizeof(whole));
+    }
+    else { ok = dict_string(info, CFSTR("ParentWholeDisk"), whole, sizeof(whole)); }
+    CFRelease(info);
+    if (!ok || !bsd_disk_name(whole) || strchr(whole + 4, 's'))
+    {
+        return xy_disk_fail(error, "mac-physical-whole-disk-missing");
+    }
+    info = disk_info(whole, error);
+    if (!info) { return false; }
+    char kind[64];
+    ok = dict_string(info, CFSTR("VirtualOrPhysical"), kind, sizeof(kind)) && !strcmp(kind, "Physical");
+    CFRelease(info);
+    if (!ok) { return xy_disk_fail(error, "mac-system-disk-not-physical"); }
+    if (!media_serial(whole, disk->serial, error)) { return false; }
+    int n = snprintf(disk->device, sizeof(disk->device), "/dev/%s", whole);
+    if (n < 0 || n >= (int)sizeof(disk->device)) { return xy_disk_fail(error, "mac-device-name-length"); }
+    return true;
+}
+#endif
