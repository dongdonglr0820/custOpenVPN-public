diff --git a/src/openvpn/win_device_identity.c b/src/openvpn/win_device_identity.c
new file mode 100644
index 00000000..78911d44
--- /dev/null
+++ b/src/openvpn/win_device_identity.c
@@ -0,0 +1,303 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#define SECURITY_WIN32
+#include "win_device_identity.h"
+#include "openvpn-msg.h"
+#include <winioctl.h>
+#include <security.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#define XY_QUERY_TIMEOUT 3000
+#define XY_MAX_DESCRIPTOR (64 * 1024)
+#ifndef XY_EXCHANGE_TIMEOUT
+#define XY_EXCHANGE_TIMEOUT 15000
+#endif
+
+static DWORD
+fail(xy_identity_error *error, const char *stage, DWORD code)
+{
+    error->code = code ? code : ERROR_INVALID_DATA;
+    snprintf(error->stage, sizeof(error->stage), "%s", stage);
+    return error->code;
+}
+
+/* Buffers stay alive until cancellation completes, including on timeout. */
+static DWORD
+query(HANDLE device, DWORD code, void *input, DWORD input_size,
+       void *output, DWORD output_size, DWORD *received)
+{
+    OVERLAPPED ov = {0};
+    ov.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!ov.hEvent) { return GetLastError(); }
+    DWORD error = ERROR_SUCCESS;
+    if (!DeviceIoControl(device, code, input, input_size, output, output_size, received, &ov))
+    {
+        error = GetLastError();
+        if (error == ERROR_IO_PENDING)
+        {
+            DWORD wait = WaitForSingleObject(ov.hEvent, XY_QUERY_TIMEOUT);
+            if (wait != WAIT_OBJECT_0)
+            {
+                CancelIoEx(device, &ov);
+                GetOverlappedResult(device, &ov, received, TRUE);
+                error = ERROR_TIMEOUT;
+            }
+            else if (!GetOverlappedResult(device, &ov, received, FALSE)) { error = GetLastError(); }
+            else { error = ERROR_SUCCESS; }
+        }
+    }
+    CloseHandle(ov.hEvent);
+    return error;
+}
+
+DWORD
+xy_collect_user(char user[XY_ID_USER_CAP], xy_identity_error *error)
+{
+    user[0] = '\0';
+    HANDLE token = NULL;
+    union { TOKEN_USER alignment; unsigned char bytes[1024]; } token_buf;
+    DWORD size = 0;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+    { return fail(error, "user-token", GetLastError()); }
+    BOOL ok = GetTokenInformation(token, TokenUser, &token_buf, sizeof(token_buf), &size);
+    DWORD code = ok ? ERROR_SUCCESS : GetLastError();
+    CloseHandle(token);
+    if (!ok) { return fail(error, "user-token", code); }
+    PSID sid = ((TOKEN_USER *)&token_buf)->User.Sid;
+    if (IsWellKnownSid(sid, WinLocalSystemSid) || IsWellKnownSid(sid, WinLocalServiceSid)
+        || IsWellKnownSid(sid, WinNetworkServiceSid))
+    { return fail(error, "unsupported-service-user", ERROR_NOT_SUPPORTED); }
+    WCHAR name[512];
+    ULONG count = (ULONG)(sizeof(name) / sizeof(name[0]));
+    if (!GetUserNameExW(NameSamCompatible, name, &count))
+    { return fail(error, "user-name", GetLastError()); }
+    char encoded[XY_ID_USER_CAP];
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, name, -1, encoded,
+                            sizeof(encoded), NULL, NULL))
+    { return fail(error, "user-encoding", GetLastError()); }
+    if (!xy_identity_text(encoded, sizeof(encoded), user, XY_ID_USER_CAP))
+    { return fail(error, "user-invalid", ERROR_INVALID_DATA); }
+    return ERROR_SUCCESS;
+}
+
+static DWORD
+collect_uuid(char uuid[37], xy_identity_error *error)
+{
+    /* Equivalent to the RSMB provider constant, without multi-char literals. */
+    const DWORD provider = 0x52534D42;
+    UINT size = GetSystemFirmwareTable(provider, 0, NULL, 0);
+    if (!size || size > 1024 * 1024)
+    { return fail(error, "smbios-size", ERROR_INVALID_DATA); }
+    unsigned char *buf = malloc(size);
+    if (!buf) { return fail(error, "smbios-memory", ERROR_NOT_ENOUGH_MEMORY); }
+    UINT got = GetSystemFirmwareTable(provider, 0, buf, size);
+    bool ok = got && got <= size && xy_identity_smbios(buf, got, uuid);
+    free(buf);
+    return ok ? ERROR_SUCCESS : fail(error, "smbios-uuid", ERROR_INVALID_DATA);
+}
+
+DWORD
+xy_collect_hardware(xy_hardware_identity *id, xy_identity_error *error)
+{
+    memset(id, 0, sizeof(*id));
+    memset(error, 0, sizeof(*error));
+    DWORD code = collect_uuid(id->uuid, error);
+    if (code) { return code; }
+    WCHAR windows[MAX_PATH], mount[MAX_PATH], volume[MAX_PATH], disk_path[64];
+    UINT len = GetSystemWindowsDirectoryW(windows, MAX_PATH);
+    if (!len || len >= MAX_PATH)
+    { return fail(error, "windows-directory", ERROR_BAD_PATHNAME); }
+    if (!GetVolumePathNameW(windows, mount, MAX_PATH)
+        || !GetVolumeNameForVolumeMountPointW(mount, volume, MAX_PATH))
+    { return fail(error, "windows-volume", GetLastError()); }
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, mount, -1,
+                            id->volume, sizeof(id->volume), NULL, NULL))
+    { return fail(error, "volume-encoding", GetLastError()); }
+    size_t vol_len = wcslen(volume);
+    if (!vol_len || volume[vol_len - 1] != L'\\')
+    { return fail(error, "volume-path", ERROR_BAD_PATHNAME); }
+    volume[vol_len - 1] = L'\0';
+    HANDLE vol = CreateFileW(volume, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                             OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    if (vol == INVALID_HANDLE_VALUE) { return fail(error, "volume-open", GetLastError()); }
+    const DWORD ext_size = (DWORD)(offsetof(VOLUME_DISK_EXTENTS, Extents) + 128 * sizeof(DISK_EXTENT));
+    VOLUME_DISK_EXTENTS *ext = calloc(1, ext_size);
+    if (!ext) { CloseHandle(vol); return fail(error, "extent-memory", ERROR_NOT_ENOUGH_MEMORY); }
+    DWORD received = 0;
+    code = query(vol, IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS, NULL, 0, ext, ext_size, &received);
+    CloseHandle(vol);
+    uint32_t numbers[128];
+    if (!code)
+    {
+        size_t start = offsetof(VOLUME_DISK_EXTENTS, Extents);
+        if (received < start || !ext->NumberOfDiskExtents || ext->NumberOfDiskExtents > 128
+            || ext->NumberOfDiskExtents > (received - start) / sizeof(DISK_EXTENT))
+        { code = ERROR_INVALID_DATA; }
+        else
+        {
+            for (DWORD i = 0; i < ext->NumberOfDiskExtents; ++i) { numbers[i] = ext->Extents[i].DiskNumber; }
+            if (!xy_identity_disk(numbers, ext->NumberOfDiskExtents, &id->disk_number))
+            { code = ERROR_NOT_SUPPORTED; }
+        }
+    }
+    free(ext);
+    if (code) { return fail(error, "volume-disk-extents", code); }
+    swprintf(disk_path, sizeof(disk_path) / sizeof(disk_path[0]), L"\\\\.\\PhysicalDrive%lu",
+             (unsigned long)id->disk_number);
+    HANDLE disk = CreateFileW(disk_path, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                              OPEN_EXISTING, FILE_FLAG_OVERLAPPED, NULL);
+    if (disk == INVALID_HANDLE_VALUE) { return fail(error, "system-disk-open", GetLastError()); }
+    STORAGE_PROPERTY_QUERY prop = {0};
+    prop.PropertyId = StorageDeviceProperty;
+    prop.QueryType = PropertyStandardQuery;
+    STORAGE_DESCRIPTOR_HEADER head = {0};
+    code = query(disk, IOCTL_STORAGE_QUERY_PROPERTY, &prop, sizeof(prop), &head, sizeof(head), &received);
+    if (!code && (received < sizeof(head) || head.Size < sizeof(STORAGE_DEVICE_DESCRIPTOR)
+                  || head.Size > XY_MAX_DESCRIPTOR)) { code = ERROR_INVALID_DATA; }
+    if (code) { CloseHandle(disk); return fail(error, "storage-descriptor-size", code); }
+    DWORD allocation = head.Size;
+    STORAGE_DEVICE_DESCRIPTOR *desc = calloc(1, allocation);
+    if (!desc) { CloseHandle(disk); return fail(error, "storage-memory", ERROR_NOT_ENOUGH_MEMORY); }
+    code = query(disk, IOCTL_STORAGE_QUERY_PROPERTY, &prop, sizeof(prop), desc, allocation, &received);
+    CloseHandle(disk);
+    if (!code && (received < sizeof(*desc) || desc->Size > received || desc->Size < sizeof(*desc)
+                  || desc->Version < sizeof(*desc))) { code = ERROR_INVALID_DATA; }
+    if (!code)
+    {
+        size_t minimum = offsetof(STORAGE_DEVICE_DESCRIPTOR, RawDeviceProperties);
+        if (!xy_identity_descriptor((unsigned char *)desc, desc->Size, desc->SerialNumberOffset,
+                                    minimum, id->serial, sizeof(id->serial))) { code = ERROR_INVALID_DATA; }
+        if (desc->ProductIdOffset >= minimum && desc->ProductIdOffset < desc->Size)
+        {
+            /* Model is diagnostic only, never an alternative device identity. */
+            xy_identity_text((char *)desc + desc->ProductIdOffset,
+                             desc->Size - desc->ProductIdOffset, id->model, sizeof(id->model));
+        }
+    }
+    free(desc);
+    return code ? fail(error, "system-disk-serial", code) : ERROR_SUCCESS;
+}
+
+bool
+xy_hardware_valid(const xy_hardware_identity *id)
+{
+    char scratch[1024];
+    if (!xy_identity_text(id->uuid, sizeof(id->uuid), scratch, sizeof(scratch)) || strlen(scratch) != 36)
+    { return false; }
+    for (size_t i = 0; i < 36; ++i)
+    {
+        char c = scratch[i];
+        if (i == 8 || i == 13 || i == 18 || i == 23)
+        { if (c != '-') { return false; } }
+        else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')))
+        { return false; }
+    }
+    if (strcmp(id->uuid, "00000000-0000-0000-0000-000000000000") == 0
+        || _stricmp(id->uuid, "FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF") == 0)
+    { return false; }
+    if (!memchr(id->model, 0, sizeof(id->model))) { return false; }
+    if (id->model[0] && !xy_identity_text(id->model, sizeof(id->model), scratch, sizeof(scratch)))
+    { return false; }
+    return xy_identity_serial(id->serial, sizeof(id->serial), scratch, sizeof(scratch))
+           && xy_identity_text(id->volume, sizeof(id->volume), scratch, sizeof(scratch));
+}
+
+typedef struct
+{
+    LONG refs;
+    HANDLE pipe;
+    DWORD result;
+    bool valid_response;
+    xy_identity_request_t request;
+    xy_identity_response_t response;
+} xy_exchange;
+
+static void
+release_exchange(xy_exchange *exchange)
+{
+    if (InterlockedDecrement(&exchange->refs) == 0) { free(exchange); }
+}
+
+static DWORD WINAPI
+exchange_worker(void *arg)
+{
+    xy_exchange *exchange = arg;
+    DWORD n = 0;
+    if (!WriteFile(exchange->pipe, &exchange->request, sizeof(exchange->request), &n, NULL)
+        || n != sizeof(exchange->request)
+        || !ReadFile(exchange->pipe, &exchange->response, sizeof(exchange->response), &n, NULL))
+    { exchange->result = GetLastError() ? GetLastError() : ERROR_INVALID_DATA; }
+    else if (n != sizeof(exchange->response)
+             || exchange->response.header.size != sizeof(exchange->response)
+             || exchange->response.header.type != msg_xy_device_identity_response
+             || exchange->response.header.message_id != exchange->request.header.message_id
+             || exchange->response.version != XY_ID_PROTOCOL)
+    { exchange->result = ERROR_REVISION_MISMATCH; }
+    else if (!memchr(exchange->response.error.stage, 0, sizeof(exchange->response.error.stage)))
+    { exchange->result = ERROR_INVALID_DATA; }
+    else
+    {
+        exchange->valid_response = true;
+        if (exchange->response.error.code) { exchange->result = exchange->response.error.code; }
+        else if (!xy_hardware_valid(&exchange->response.identity)) { exchange->result = ERROR_INVALID_DATA; }
+    }
+    CloseHandle(exchange->pipe);
+    release_exchange(exchange);
+    return 0;
+}
+
+DWORD
+xy_get_hardware(HANDLE pipe, xy_hardware_identity *id, xy_identity_error *error)
+{
+    if (!pipe || pipe == INVALID_HANDLE_VALUE) { return xy_collect_hardware(id, error); }
+    memset(id, 0, sizeof(*id));
+    memset(error, 0, sizeof(*error));
+    xy_exchange *exchange = calloc(1, sizeof(*exchange));
+    if (!exchange) { return fail(error, "service-memory", ERROR_NOT_ENOUGH_MEMORY); }
+    exchange->refs = 2;
+    exchange->request.header.type = msg_xy_device_identity;
+    exchange->request.header.size = sizeof(exchange->request);
+    exchange->request.header.message_id = 0x5859;
+    exchange->request.version = XY_ID_PROTOCOL;
+    if (!DuplicateHandle(GetCurrentProcess(), pipe, GetCurrentProcess(), &exchange->pipe,
+                          0, FALSE, DUPLICATE_SAME_ACCESS))
+    {
+        DWORD code = GetLastError();
+        free(exchange);
+        return fail(error, "service-handle", code);
+    }
+    HANDLE worker = CreateThread(NULL, 0, exchange_worker, exchange, 0, NULL);
+    if (!worker)
+    {
+        DWORD code = GetLastError();
+        CloseHandle(exchange->pipe);
+        free(exchange);
+        return fail(error, "service-thread", code);
+    }
+    DWORD wait = WaitForSingleObject(worker, XY_EXCHANGE_TIMEOUT);
+    DWORD code;
+    if (wait == WAIT_OBJECT_0)
+    {
+        code = exchange->result;
+        if (!code) { *id = exchange->response.identity; }
+        else if (exchange->valid_response && exchange->response.error.code == code
+                 && exchange->response.error.stage[0])
+        { *error = exchange->response.error; }
+        else { fail(error, "service-protocol", code); }
+    }
+    else
+    {
+        /* Synchronous pipe I/O runs on an owned worker, never on the main loop. */
+        CancelSynchronousIo(worker);
+        WaitForSingleObject(worker, 1000);
+        code = fail(error, "service-timeout", ERROR_TIMEOUT);
+    }
+    CloseHandle(worker);
+    release_exchange(exchange);
+    return code;
+}
