diff --git a/src/openvpn/device_identity_parse.c b/src/openvpn/device_identity_parse.c
new file mode 100644
index 00000000..7d629515
--- /dev/null
+++ b/src/openvpn/device_identity_parse.c
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "device_identity_parse.h"
+#include <stdio.h>
+#include <string.h>
+
+bool
+xy_identity_text(const char *src, size_t size, char *out, size_t cap)
+{
+    if (!src || !out || !cap)
+    {
+        return false;
+    }
+    out[0] = '\0';
+    const char *end = memchr(src, '\0', size);
+    if (!end)
+    {
+        return false;
+    }
+    /* Do not trim control characters: newline/tab input must be rejected. */
+    for (const char *p = src; p < end; ++p)
+    {
+        if ((unsigned char)*p < 32 || (unsigned char)*p == 127)
+        {
+            return false;
+        }
+    }
+    while (src < end && *src == ' ')
+    {
+        ++src;
+    }
+    while (end > src && end[-1] == ' ')
+    {
+        --end;
+    }
+    size_t n = (size_t)(end - src);
+    if (!n || n >= cap)
+    {
+        return false;
+    }
+    memcpy(out, src, n);
+    out[n] = '\0';
+    return true;
+}
+
+static bool
+ascii_equal(const char *a, const char *b)
+{
+    while (*a && *b)
+    {
+        unsigned char x = (unsigned char)*a++, y = (unsigned char)*b++;
+        if (x >= 'a' && x <= 'z') { x -= 'a' - 'A'; }
+        if (y >= 'a' && y <= 'z') { y -= 'a' - 'A'; }
+        if (x != y) { return false; }
+    }
+    return *a == *b;
+}
+
+bool
+xy_identity_serial(const char *src, size_t size, char *out, size_t cap)
+{
+    if (!xy_identity_text(src, size, out, cap)) { return false; }
+    const char *invalid[] = { "UNKNOWN", "NONE", "N/A", "NOT SPECIFIED", "NOT PRESENT",
+                              "DEFAULT STRING", "TO BE FILLED BY O.E.M." };
+    for (size_t i = 0; i < sizeof(invalid) / sizeof(invalid[0]); ++i)
+    {
+        if (ascii_equal(out, invalid[i])) { out[0] = '\0'; return false; }
+    }
+    bool all_zero = true, all_ff = true;
+    for (const char *p = out; *p; ++p)
+    {
+        if (*p == '_' || *p == '.' || *p == '-' || *p == ' ') { continue; }
+        if (*p != '0') { all_zero = false; }
+        if (*p != 'F' && *p != 'f') { all_ff = false; }
+    }
+    if (all_zero || all_ff) { out[0] = '\0'; return false; }
+    return true;
+}
+
+bool
+xy_identity_descriptor(const unsigned char *buf, size_t size, uint32_t offset,
+                        size_t minimum_offset, char *out, size_t cap)
+{
+    return offset >= minimum_offset && offset < size
+           && xy_identity_serial((const char *)buf + offset, size - offset, out, cap);
+}
+
+bool
+xy_identity_disk(const uint32_t *numbers, size_t count, uint32_t *number)
+{
+    if (!numbers || !count || count > 128 || !number) { return false; }
+    for (size_t i = 1; i < count; ++i)
+    {
+        if (numbers[i] != numbers[0]) { return false; }
+    }
+    *number = numbers[0];
+    return true;
+}
+
+static uint32_t
+read_le32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16)
+           | ((uint32_t)p[3] << 24);
+}
+
+bool
+xy_identity_smbios(const unsigned char *buf, size_t size, char uuid[37])
+{
+    uuid[0] = '\0';
+    if (!buf || size < 8) { return false; }
+    size_t table_len = read_le32(buf + 4);
+    if (table_len > size - 8) { return false; }
+    const size_t end = 8 + table_len;
+    for (size_t pos = 8; pos + 4 <= end; )
+    {
+        size_t len = buf[pos + 1];
+        if (len < 4 || len > end - pos) { return false; }
+        size_t next = pos + len;
+        while (next + 1 < end && (buf[next] != 0 || buf[next + 1] != 0)) { ++next; }
+        if (next + 1 >= end) { return false; }
+        if (buf[pos] == 1)
+        {
+            if (len < 24) { return false; }
+            const unsigned char *p = buf + pos + 8;
+            bool zero = true, ff = true;
+            for (size_t i = 0; i < 16; ++i)
+            {
+                if (p[i]) { zero = false; }
+                if (p[i] != 255) { ff = false; }
+            }
+            if (zero || ff) { return false; }
+            bool le = buf[1] > 2 || (buf[1] == 2 && buf[2] >= 6);
+            static const unsigned char order[16] = { 3,2,1,0,5,4,7,6,8,9,10,11,12,13,14,15 };
+            unsigned char v[16];
+            for (size_t i = 0; i < 16; ++i) { v[i] = p[le ? order[i] : i]; }
+            snprintf(uuid, 37,
+                     "%02X%02X%02X%02X-%02X%02X-%02X%02X-%02X%02X-%02X%02X%02X%02X%02X%02X",
+                     v[0],v[1],v[2],v[3],v[4],v[5],v[6],v[7],v[8],v[9],v[10],v[11],v[12],v[13],v[14],v[15]);
+            return true;
+        }
+        if (buf[pos] == 127) { break; }
+        pos = next + 2;
+    }
+    return false;
+}
+
+bool
+xy_identity_reserved_env(const char *entry)
+{
+    const char *keys[] = { "IV_PLAT=", "IV_USER=", "IV_INFO=", "IV_DISK=", "UV_DEVICE_ID_SCHEMA=" };
+    for (size_t i = 0; i < sizeof(keys) / sizeof(keys[0]); ++i)
+    {
+        if (strncmp(entry, keys[i], strlen(keys[i])) == 0) { return true; }
+    }
+    return false;
+}
