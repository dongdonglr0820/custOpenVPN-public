+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef WIN_DEVICE_IDENTITY_H
+#define WIN_DEVICE_IDENTITY_H
+#ifdef _WIN32
+#include <windows.h>
+#include "device_identity_parse.h"
+
+#define XY_ID_PROTOCOL 1
+typedef struct
+{
+    char uuid[37];
+    char serial[XY_ID_SERIAL_CAP];
+    char model[128];
+    char volume[1024];
+    uint32_t disk_number;
+} xy_hardware_identity;
+
+typedef struct
+{
+    DWORD code;
+    char stage[64];
+} xy_identity_error;
+
+DWORD xy_collect_hardware(xy_hardware_identity *id, xy_identity_error *error);
+DWORD xy_collect_user(char user[XY_ID_USER_CAP], xy_identity_error *error);
+DWORD xy_get_hardware(HANDLE pipe, xy_hardware_identity *id, xy_identity_error *error);
+bool xy_hardware_valid(const xy_hardware_identity *id);
+#endif
+#endif
diff --git a/src/openvpn/win_device_identity_core.c b/src/openvpn/win_device_identity_core.c
new file mode 100644
index 00000000..33403661
--- /dev/null
+++ b/src/openvpn/win_device_identity_core.c
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include "syshead.h"
+#include "win_device_identity_core.h"
+#include "win_device_identity.h"
+#include "error.h"
+
+static bool
+collect(HANDLE pipe, char user[XY_ID_USER_CAP], xy_hardware_identity *id)
+{
+    xy_identity_error error = {0};
+    if (xy_collect_user(user, &error) || xy_get_hardware(pipe, id, &error))
+    {
+        msg(M_WARN, "DEVICE_IDENTITY_ERROR stage=%s win32=%lu schema=%s",
+            error.stage, error.code, XY_ID_SCHEMA);
+        return false;
+    }
+    return true;
+}
+
+const char *
+win_device_peer_info(HANDLE pipe, const struct env_set *es, struct gc_arena *gc)
+{
+    for (const struct env_item *e = es ? es->list : NULL; e; e = e->next)
+    {
+        if (e->string && xy_identity_reserved_env(e->string))
+        {
+            msg(M_FATAL, "DEVICE_IDENTITY_CONFIG_CONFLICT: remove setenv IV_PLAT/IV_USER/IV_INFO/IV_DISK/UV_DEVICE_ID_SCHEMA; Windows collects these automatically");
+        }
+    }
+    xy_hardware_identity id;
+    char user[XY_ID_USER_CAP];
+    if (!collect(pipe, user, &id))
+    {
+        msg(M_FATAL, "Cannot collect Windows device identity. Use --show-device-info in an elevated terminal to diagnose; install the matching interactive service for GUI use.");
+    }
+    struct buffer out = alloc_buf_gc(1024, gc);
+    if (!buf_printf(&out, "IV_PLAT=win\nIV_USER=%s\nIV_INFO=%s\nIV_DISK=%s\nUV_DEVICE_ID_SCHEMA=%s\n",
+                    user, id.uuid, id.serial, XY_ID_SCHEMA))
+    {
+        msg(M_FATAL, "DEVICE_IDENTITY_ERROR: peer-info exceeds maximum size");
+    }
+    msg(M_INFO, "Windows device identity collected: schema=%s source=windows-volume via=%s",
+        XY_ID_SCHEMA, pipe ? "interactive-service" : "direct");
+    return BSTR(&out);
+}
+
+bool
+win_show_device_info(HANDLE pipe)
+{
+    xy_hardware_identity id;
+    char user[XY_ID_USER_CAP];
+    if (!collect(pipe, user, &id)) { return false; }
+    msg(M_INFO | M_NOPREFIX, "schema=%s", XY_ID_SCHEMA);
+    msg(M_INFO | M_NOPREFIX, "via=%s", pipe ? "interactive-service" : "direct");
+    msg(M_INFO | M_NOPREFIX, "windows_volume=%s", id.volume);
+    msg(M_INFO | M_NOPREFIX, "disk_number=%lu", (unsigned long)id.disk_number);
+    msg(M_INFO | M_NOPREFIX, "disk_model=%s", id.model);
+    msg(M_INFO | M_NOPREFIX, "IV_PLAT=win");
+    msg(M_INFO | M_NOPREFIX, "IV_USER=%s", user);
+    msg(M_INFO | M_NOPREFIX, "IV_INFO=%s", id.uuid);
+    msg(M_INFO | M_NOPREFIX, "IV_DISK=%s", id.serial);
+    return true;
+}
