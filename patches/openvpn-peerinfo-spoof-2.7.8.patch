From 091d27a218419602681d8d9334ad689bc80a07e5 Mon Sep 17 00:00:00 2001
From: sunnoy <ttzhsz@163.com>
Date: Thu, 17 Sep 2026 18:49:22 +0800
Subject: [PATCH] peerinfo: forward setenv IV_PLAT/IV_USER/IV_INFO/IV_DISK for
 device binding

XYLink custom client sends device fingerprints via setenv IV_USER /
IV_INFO / IV_DISK (and IV_PLAT override). Stock push_peer_info() drops
these, so the zzj compat gate sees an empty fingerprint set and rejects
the connection with INCOMPATIBLE_CLIENT.

Adapted from the 2.6.14 build at ~/ovpn-build/openvpn-peerinfo-spoof.patch;
on 2.7 the IV_SSO condition closes on the same source line, so that hunk
context was adjusted by hand.
---
 src/openvpn/ssl.c | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/openvpn/ssl.c b/src/openvpn/ssl.c
index a2eee6a7..56004d9c 100644
--- a/src/openvpn/ssl.c
+++ b/src/openvpn/ssl.c
@@ -65,6 +65,7 @@
 
 #include "memdbg.h"
 #include "openvpn.h"
+#include "env_set.h" /* peer-info spoof: env_set_get() for IV_PLAT override */
 
 #ifdef MEASURE_TLS_HANDSHAKE_STATS
 
@@ -1940,7 +1941,10 @@ push_peer_info(struct buffer *buf, struct tls_session *session)
         /* push version */
         buf_printf(&out, "IV_VER=%s\n", PACKAGE_VERSION);
 
-        /* push platform */
+        /* push platform (peer-info spoof: skip built-in value if the
+         * config overrides it via `setenv IV_PLAT ...`) */
+        if (!env_set_get(session->opt->es, "IV_PLAT"))
+        {
 #if defined(TARGET_LINUX)
         buf_printf(&out, "IV_PLAT=linux\n");
 #elif defined(TARGET_SOLARIS)
@@ -1958,6 +1962,7 @@ push_peer_info(struct buffer *buf, struct tls_session *session)
 #elif defined(_WIN32)
         buf_printf(&out, "IV_PLAT=win\n");
 #endif
+        }
         /* Announce that we do not require strict sequence numbers with
          * TCP. (TCP non-linear) */
         buf_printf(&out, "IV_TCPNL=1\n");
@@ -2057,7 +2062,9 @@ push_peer_info(struct buffer *buf, struct tls_session *session)
         if (session->opt->push_peer_info_detail > 1)
         {
             struct env_set *es = session->opt->es;
-            /* push env vars that begin with UV_, IV_PLAT_VER and IV_GUI_VER */
+            /* push env vars that begin with UV_, IV_PLAT_VER and IV_GUI_VER
+             * (peer-info spoof: also forward corp device-fingerprint vars set
+             * via `setenv IV_PLAT/IV_USER/IV_INFO/IV_DISK ...`) */
             for (struct env_item *e = es->list; e != NULL; e = e->next)
             {
                 if (e->string)
@@ -2066,7 +2073,11 @@ push_peer_info(struct buffer *buf, struct tls_session *session)
                            || strncmp(e->string, "IV_PLAT_VER=", sizeof("IV_PLAT_VER=") - 1) == 0)
                           && session->opt->push_peer_info_detail > 2)
                          || (strncmp(e->string, "IV_GUI_VER=", sizeof("IV_GUI_VER=") - 1) == 0)
-                         || (strncmp(e->string, "IV_SSO=", sizeof("IV_SSO=") - 1) == 0))
+                         || (strncmp(e->string, "IV_SSO=", sizeof("IV_SSO=") - 1) == 0)
+                         || (strncmp(e->string, "IV_PLAT=", sizeof("IV_PLAT=") - 1) == 0)
+                         || (strncmp(e->string, "IV_USER=", sizeof("IV_USER=") - 1) == 0)
+                         || (strncmp(e->string, "IV_INFO=", sizeof("IV_INFO=") - 1) == 0)
+                         || (strncmp(e->string, "IV_DISK=", sizeof("IV_DISK=") - 1) == 0))
                         && buf_safe(&out, strlen(e->string) + 1))
                     {
                         buf_printf(&out, "%s\n", e->string);
-- 
